<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campus Notices"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Examination Timetable"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The examination timetable is now available."
            android:textSize="16sp"
            android:textColor="#424242"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Library Notice"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The library will remain open until 20:00 during examination week."
            android:textSize="16sp"
            android:textColor="#424242"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Student Meeting"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All students are invited to a campus meeting on Friday."
            android:textSize="16sp"
            android:textColor="#424242"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Home"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#123C78"
        android:gravity="center"
        android:padding="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Campus Companion"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#123C78"
        android:paddingTop="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome, Student!"
        android:textSize="20sp"
        android:paddingTop="15dp"
        android:paddingBottom="20dp"/>

    <Button
        android:id="@+id/btnTimetable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Timetable"
        android:contentDescription="Open class timetable"
        android:minHeight="48dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnNotices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Notices"
        android:contentDescription="Open campus notices"
        android:minHeight="48dp"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upcoming Class"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingTop="25dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Structures&#10;10:00 - 11:00&#10;Room: CS Lab 2"
        android:textSize="18sp"
        android:padding="15dp"/>

    <TextView
        android:id="@+id/tvHomeEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No upcoming classes scheduled."
        android:textSize="16sp"
        android:textColor="#555555"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tvHomeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unable to load upcoming classes. Please try again."
        android:textSize="16sp"
        android:textColor="#B00020"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
